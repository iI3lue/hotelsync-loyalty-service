# Copiar a .env (nunca commitear valores reales)
NODE_ENV=development
PORT=3009

# Base de datos propia del servicio (Neon en produccion)
DATABASE_URL=postgresql://usuario:password@host:5432/loyalty_db?sslmode=require

# HS256 compartido por todos los servicios (minimo 32 caracteres)
AUTH_JWT_SECRET=

# RabbitMQ (CloudAMQP). Vacio = eventos deshabilitados, el servicio arranca igual.
RABBITMQ_URL=

# Dependencias REST
BOOKING_SERVICE_URL=http://localhost:3004/v1
USER_SERVICE_URL=http://localhost:3003/v1

# Clave interna compartida: booking y user la validan (header x-loyalty-key)
LOYALTY_SERVICE_KEY=

# --- Gateway: verificación de x-gateway-secret (ver ROLLOUT-GATEWAY.md) ---
# Secreto compartido entre gateway/BFF y los 11 servicios. Vacío = verificación apagada.
GATEWAY_SECRET=
# Solo durante una rotación: el secreto anterior que aún se acepta.
GATEWAY_SECRET_PREVIOUS=
# warn (por defecto): solo registra; enforce: responde 401 si falta el secreto.
GATEWAY_MODE=warn
